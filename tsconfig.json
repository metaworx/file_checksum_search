{
	"include": ["./src/**/*.ts"],
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "js",
		"rootDir": "src",
		"declaration": false,
		"sourceMap": false,
		"erasableSyntaxOnly": true
	}
}