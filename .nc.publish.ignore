# .nc.publish.ignore — files/directories excluded from the Nextcloud App Store
# release package. Consumed by package.sh via `rsync --exclude-from`.
#
# Patterns use rsync(1) exclude syntax:
#   - a leading '/' anchors the pattern to the package root
#   - '*' matches within a single path component
#   - unanchored patterns match at any depth

# VCS / repository metadata
.git
.gitignore
.gitattributes
.gitmodules
.github
# Placeholder files
*.gitkeep

# Release tooling (this file and the packaging script)
/.nc.publish.ignore
/package.sh
/.gitlab/

# Translation tooling and sources: l10n/ ships, what it is made from does not
/scripts/
/.l10nignore
/translationfiles/

# IDE / editor
.idea
.editorconfig

# Agent / project tooling
/GUIDELINES
/AGENTS.md
/.aiignore
/.roo
/.junie
/.appstore

# Node / frontend tooling
/node_modules
/src
/package.json
/package-lock.json
/.nvmrc
/.eslintrc.cjs
/stylelint.config.cjs
/tsconfig.json
/vite.config.ts
/cypress.config.cjs

# PHP tooling
/vendor
/vendor-bin
/ecs.php
/psalm.xml
/rector.php

# Tests & dev-only docs
/tests
/docs/app-store-publishing.md
/CONTRIBUTING.md
/CODE_OF_CONDUCT.md
/CODE_STYLE.md

# Build artifacts
/build
/dist

# Legacy scaffold artifacts
/app
/app.tar
/app.nc_checksum

# Local-only working directories. These are gitignored, so they never show up
# in `git status`, but rsync copies them into the package all the same — the
# nextcloud-v* trees are full Nextcloud checkouts created by
# `nc-test --link` (see GUIDELINES/shared TESTING.md 9.1) and carry their own
# data/ directory.
/nextcloud-v*
/cypress
/.cache
/.claude

# Test tooling not covered above
/vitest.config.ts
/vitest.setup.ts
