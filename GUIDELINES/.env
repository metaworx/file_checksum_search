# Where the agent documents live, relative to the project root.
# Git-versioned on purpose: every agent, script and generated file resolves
# document paths through these two values.
#
# {{.aiassistant_root}}   - the project's own agent directory (PROJECT.md,
#                           CI.md, and the runtime chat/, messages/, temp/ dirs)
# {{.aiassistant_shared}} - the shared guidelines submodule
AIASSISTANT_ROOT=.aiassistant
AIASSISTANT_SHARED=.aiassistant/shared
