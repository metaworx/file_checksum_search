		<admin-section>OCA\FileChecksumSearch\Settings\AdminSection</admin-section>
		<personal>OCA\FileChecksumSearch\Settings\Personal</personal>
		<personal-section>OCA\FileChecksumSearch\Settings\PersonalSection</personal-section>
	</settings>
	<navigations>
