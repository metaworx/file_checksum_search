<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>file_checksum_search</id>
	<name>File Checksum Index &amp; Search</name>
	<summary>Index file checksums for fast reverse hash lookups</summary>
	<description>
		Deploys a MariaDB shadow table with automatic trigger-based synchronization
		from oc_filecache, enabling O(1) reverse hash lookups. Provides a REST API,
		Unified Search provider, CLI commands, and an admin settings page for
		maintenance operations.
	</description>
	<version>0.11.0</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="apps@metaworx.ch"
	        homepage="">metaworx resonare rüegg
	</author>
	<namespace>FileChecksumSearch</namespace>
	<category>files</category>
	<category>search</category>
	<website>https://gitlab.com/metaworx/open-source/nextcloud/file_checksum_search</website>
	<bugs>https://gitlab.com/metaworx/open-source/nextcloud/file_checksum_search/-/work_items</bugs>
	<repository type="git">git@gitlab.com:metaworx/open-source/nextcloud/file_checksum_search.git</repository>
	<dependencies>
		<nextcloud min-version="33"
		           max-version="34"/>
	</dependencies>
	<settings>
		<admin>OCA\FileChecksumSearch\Settings\Admin</admin>
	</settings>
	<navigations>
		<navigation>
			<id>file_checksum_search</id>
			<name>Duplicates</name>
			<route>file_checksum_search.page.index</route>
			<order>5</order>
		</navigation>
	</navigations>
	<commands>
		<command>OCA\FileChecksumSearch\Command\RebuildIndex</command>
		<command>OCA\FileChecksumSearch\Command\SearchHash</command>
		<command>OCA\FileChecksumSearch\Command\GenerateHashes</command>
		<command>OCA\FileChecksumSearch\Command\TestPerformance</command>
		<command>OCA\FileChecksumSearch\Command\ShowStatus</command>
		<command>OCA\FileChecksumSearch\Command\ShowConfig</command>
		<command>OCA\FileChecksumSearch\Command\FindDuplicates</command>
	</commands>
	<background-jobs>
		<job>OCA\FileChecksumSearch\BackgroundJob\RuleProcessingJob</job>
		<job>OCA\FileChecksumSearch\BackgroundJob\ProcessPendingUpdates</job>
		<job>OCA\FileChecksumSearch\BackgroundJob\SeedPendingUpdates</job>
	</background-jobs>
</info>
