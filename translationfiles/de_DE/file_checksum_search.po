msgstr "Aktiviert"

msgid "Enforced"
msgstr "Erzwungen"

msgid "Enforced — all home folders"
msgstr "Erzwungen – alle Home-Ordner"

msgid "Enforced — everything"
msgstr "Erzwungen – alles"

