msgstr "Permitir que todas as contas editem regras"

msgid "Allow all accounts to look across accounts"
msgstr "Permitir que todas as contas consultem outras contas"

msgid "Allow all accounts to recalculate checksums"
msgstr "Permitir que todas as contas recalculem somas de verificação"

