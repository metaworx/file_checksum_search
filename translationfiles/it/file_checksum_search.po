msgstr "Impossibile caricare lo stato (HTTP {status})."

msgid "Could not load the status."
msgstr "Impossibile caricare lo stato."

msgid "Could not open the file for reading."
msgstr "Impossibile aprire il file in lettura."

msgid "Could not reapply the rule."
msgstr "Impossibile riapplicare la regola."

msgid "Could not recalculate the checksum."
msgstr "Impossibile ricalcolare il checksum."

msgid "Could not reorder the rules."
msgstr "Impossibile riordinare le regole."

