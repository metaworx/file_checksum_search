{
	"name": "metaworx/file_checksum_search",
	"description": "File Checksum Index & Search — indexes file checksums for fast reverse hash lookups",
	"type": "nextcloud-app",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "metaworx resonare rüegg",
			"email": "apps@metaworx.ch"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\FileChecksumSearch\\": "lib/",
			"OCA\\FileChecksumSearch\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2"
		},
		"sort-packages": true
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test": "phpunit -c tests/phpunit.xml",
		"test:unit": "phpunit -c tests/phpunit.xml --testsuite unit",
		"test:integration": "phpunit -c tests/phpunit.xml --testsuite integration",
		"openapi": "generate-spec",
		"rector": "rector && composer cs:fix"
	},
	"extra": {
		"bamarni-bin": {
			"bin-links": true,
			"forward-command": false
		}
	},
	"require": {
		"php": ">=8.2",
		"bamarni/composer-bin-plugin": "^1.8"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable33",
		"roave/security-advisories": "dev-latest"
	}
}
